# Supabase project (Settings → API). Anon key memang publik; akses dibatasi RLS.
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Domain Google Workspace BSB; dipakai sebagai petunjuk akun saat login (validasi tetap di database)
NEXT_PUBLIC_GOOGLE_WORKSPACE_DOMAIN=
